{
  "workflows": {
    "RESIGNATION": {
      "workflow_id": "WF-RESIGNATION-BGV-001",
      "name": "Resignation → BGV",
      "version": "Version 3.0",
      "category": "RESIGNATION",
      "description": "End-to-end exit validation, document collection, BGV initiation, and exit clearance state machine.",
      "initial_state": "RESIGNATION_RECEIVED",
      "states": [
        "RESIGNATION_RECEIVED",
        "DOCUMENTS_REQUIRED",
        "DOCUMENTS_RECEIVED",
        "BGV_READY",
        "BGV_IN_PROGRESS",
        "BGV_COMPLETED",
        "EXIT_READY",
        "CLOSED"
      ],
      "steps_display": [
        "Resignation Received",
        "Documents Required",
        "Documents Received",
        "BGV Ready",
        "BGV In Progress",
        "BGV Completed",
        "Exit Ready",
        "Closed"
      ],
      "transitions": [
        {
          "from_state": "RESIGNATION_RECEIVED",
          "to_state": "DOCUMENTS_REQUIRED",
          "trigger": "REQUEST_DOCUMENTS",
          "conditions": [
            "employee_matched"
          ],
          "actions": [
            "set_case_on_hold",
            "send_document_request"
          ],
          "audit_event": "Exit case placed ON_HOLD; required resignation documents requested"
        },
        {
          "from_state": "RESIGNATION_RECEIVED",
          "to_state": "BGV_READY",
          "trigger": "VALIDATE_READY",
          "conditions": [
            "employee_matched",
            "all_fields_valid"
          ],
          "actions": [
            "set_case_in_progress"
          ],
          "audit_event": "Resignation fields validated; ready for BGV initiation"
        },
        {
          "from_state": "DOCUMENTS_REQUIRED",
          "to_state": "DOCUMENTS_RECEIVED",
          "trigger": "DOCUMENTS_SUBMITTED",
          "conditions": [],
          "actions": [
            "set_case_in_progress"
          ],
          "audit_event": "Required exit documents received from employee"
        },
        {
          "from_state": "DOCUMENTS_RECEIVED",
          "to_state": "BGV_READY",
          "trigger": "VALIDATE_DOCUMENTS",
          "conditions": [],
          "actions": [
            "validate_exit_pack"
          ],
          "audit_event": "Exit documents validated; workflow transitioned to BGV_READY"
        },
        {
          "from_state": "BGV_READY",
          "to_state": "BGV_IN_PROGRESS",
          "trigger": "START_BGV",
          "conditions": [],
          "actions": [
            "assign_bgv_team",
            "CREATE_BGV"
          ],
          "audit_event": "BGV verification initiated with BGV Team"
        },
        {
          "from_state": "BGV_IN_PROGRESS",
          "to_state": "BGV_COMPLETED",
          "trigger": "COMPLETE_BGV",
          "conditions": [],
          "actions": [
            "record_bgv_clearance",
            "GET_BGV_REPORT"
          ],
          "audit_event": "BGV verification completed successfully"
        },
        {
          "from_state": "BGV_COMPLETED",
          "to_state": "EXIT_READY",
          "trigger": "PREPARE_EXIT",
          "conditions": [],
          "actions": [
            "initiate_asset_and_payroll_clearance",
            "GET_EMPLOYEE_ASSETS"
          ],
          "audit_event": "Asset & payroll clearance initiated; case is EXIT_READY"
        },
        {
          "from_state": "EXIT_READY",
          "to_state": "CLOSED",
          "trigger": "CLOSE_EXIT",
          "conditions": [],
          "actions": [
            "resolve_and_close_case"
          ],
          "audit_event": "Exit processing completed and case CLOSED"
        }
      ]
    },
    "ATTENDANCE": {
      "workflow_id": "WF-ATTENDANCE-001",
      "name": "Attendance Correction",
      "version": "Version 2.0",
      "category": "ATTENDANCE",
      "description": "Validates attendance logs, fetches punches via Attendance Provider, routes to Attendance HR, and updates biometric/shift records.",
      "initial_state": "ATTENDANCE_RECEIVED",
      "states": [
        "ATTENDANCE_RECEIVED",
        "HR_VERIFICATION",
        "ATTENDANCE_UPDATED",
        "CLOSED"
      ],
      "steps_display": [
        "Attendance Received",
        "HR Verification",
        "Attendance Updated",
        "Closed"
      ],
      "transitions": [
        {
          "from_state": "ATTENDANCE_RECEIVED",
          "to_state": "HR_VERIFICATION",
          "trigger": "START_VERIFICATION",
          "conditions": [
            "employee_matched"
          ],
          "actions": [
            "set_case_in_progress",
            "FETCH_ATTENDANCE"
          ],
          "audit_event": "Attendance verification started and punch data fetched"
        },
        {
          "from_state": "HR_VERIFICATION",
          "to_state": "ATTENDANCE_UPDATED",
          "trigger": "APPROVE_CORRECTION",
          "conditions": [],
          "actions": [
            "update_attendance_log",
            "UPDATE_ATTENDANCE"
          ],
          "audit_event": "Attendance correction approved and updated in system"
        },
        {
          "from_state": "ATTENDANCE_UPDATED",
          "to_state": "CLOSED",
          "trigger": "RESOLVE_CASE",
          "conditions": [],
          "actions": [
            "resolve_and_close_case"
          ],
          "audit_event": "Attendance case resolved and closed"
        }
      ]
    },
    "LEAVE": {
      "workflow_id": "WF-LEAVE-001",
      "name": "Leave Approval Workflow",
      "version": "Version 3.0",
      "category": "LEAVE",
      "description": "Checks employee & leave balance in HRMS, processes manager/HR leave approval, and creates leave record in external HRMS.",
      "initial_state": "LEAVE_REQUEST_RECEIVED",
      "states": [
        "LEAVE_REQUEST_RECEIVED",
        "POLICY_CHECK",
        "MANAGER_APPROVAL",
        "HRMS_UPDATED",
        "CLOSED"
      ],
      "steps_display": [
        "Leave Request Received",
        "Policy Check",
        "Manager Approval",
        "HRMS Updated",
        "Closed"
      ],
      "transitions": [
        {
          "from_state": "LEAVE_REQUEST_RECEIVED",
          "to_state": "POLICY_CHECK",
          "trigger": "VERIFY_BALANCE",
          "conditions": [
            "employee_matched"
          ],
          "actions": [
            "set_case_in_progress",
            "EMPLOYEE_LOOKUP",
            "GET_LEAVE_BALANCE"
          ],
          "audit_event": "Employee & leave balance verified via HRMS"
        },
        {
          "from_state": "POLICY_CHECK",
          "to_state": "MANAGER_APPROVAL",
          "trigger": "ROUTE_MANAGER",
          "conditions": [],
          "actions": [
            "request_manager_approval"
          ],
          "audit_event": "Routed to reporting manager for approval"
        },
        {
          "from_state": "MANAGER_APPROVAL",
          "to_state": "HRMS_UPDATED",
          "trigger": "APPROVE_LEAVE",
          "conditions": [],
          "actions": [
            "update_hrms_leave",
            "CREATE_LEAVE"
          ],
          "audit_event": "Leave approved and created in external HRMS"
        },
        {
          "from_state": "HRMS_UPDATED",
          "to_state": "CLOSED",
          "trigger": "RESOLVE_CASE",
          "conditions": [],
          "actions": [
            "resolve_and_close_case"
          ],
          "audit_event": "Leave workflow completed and case closed"
        }
      ],
      "automation_config": {
        "auto_close_on_yes": true,
        "auto_run_enabled": true,
        "branch_type": "IF_ELSE",
        "condition_combinator": "AND",
        "condition_title": "IF Leave Auto-Approval Policy Passes",
        "data_enrichment": [
          "EMPLOYEE_LOOKUP",
          "GET_LEAVE_BALANCE"
        ],
        "data_mappings": [
          {
            "source": "EMPLOYEE",
            "source_path": "$ctx.employee.employee_id",
            "target": "employee_id"
          },
          {
            "source": "EMPLOYEE",
            "source_path": "$ctx.employee.department",
            "target": "department"
          },
          {
            "source": "FORM",
            "source_path": "$ctx.fields",
            "target": "request_fields"
          },
          {
            "source": "INTEGRATION_RESPONSE",
            "source_path": "$ctx.hrms",
            "target": "hrms_context"
          }
        ],
        "error_recovery": {
          "backoff_ms": 1000,
          "idempotency_key_template": "{case_id}:{node_id}:{execution_id}",
          "max_retries": 3,
          "on_exhausted": "FALLBACK_HUMAN_TASK",
          "timeout_ms": 8000
        },
        "event_correlation": {
          "auto_resume": true,
          "correlation_keys": [
            "case_id",
            "employee_id",
            "email_thread_id"
          ],
          "wait_event": "document.received"
        },
        "expression": "$ctx.employee.matched == true && $ctx.fields.missing_fields_count == 0 && $ctx.hrms.available_balance >= $ctx.fields.duration_days && $ctx.fields.duration_days <= 2",
        "form_schema": [
          {
            "field": "employee_id",
            "label": "Employee",
            "required": true,
            "type": "employee_selector",
            "visibility": "ALWAYS"
          },
          {
            "field": "leave_type",
            "label": "Leave Type",
            "options": [
              "CASUAL_LEAVE",
              "SICK_LEAVE",
              "EARNED_LEAVE",
              "COMP_OFF"
            ],
            "required": true,
            "type": "dropdown",
            "visibility": "ALWAYS"
          },
          {
            "field": "start_date",
            "label": "Start Date",
            "required": true,
            "type": "date",
            "visibility": "ALWAYS"
          },
          {
            "field": "end_date",
            "label": "End Date",
            "required": true,
            "type": "date",
            "visibility": "ALWAYS"
          },
          {
            "field": "duration_days",
            "label": "Duration (Days)",
            "required": false,
            "type": "number",
            "visibility": "ALWAYS"
          },
          {
            "field": "reason",
            "label": "Leave Reason",
            "required": true,
            "type": "textarea",
            "visibility": "ALWAYS"
          },
          {
            "field": "attachment",
            "label": "Medical Certificate",
            "required": false,
            "type": "file",
            "visibility": "fields.leave_type == 'SICK_LEAVE' && fields.duration_days > 2"
          }
        ],
        "governance": {
          "approved_by": "Amit Kumar (HR Manager)",
          "created_by": "Vaibhav (HR Admin)",
          "last_published_at": "2026-10-03 14:00:00",
          "lifecycle_status": "PUBLISHED",
          "modified_by": "Vaibhav (HR Admin)",
          "published_by": "Vaibhav (HR Admin)",
          "two_person_approval": true,
          "version_number": 3
        },
        "hold_branch_target": "LEAVE_REQUEST_RECEIVED",
        "http_webhook_config": {
          "auth_profile": "CREDENTIAL_VAULT_BEARER",
          "method": "POST",
          "rest_enabled": true,
          "url": "https://api.enterprise-hrms.internal/v1/leave/sync",
          "webhook_resume_path": "/api/webhooks/leave/callback"
        },
        "no_branch_actions": [
          "set_case_in_progress",
          "EMPLOYEE_LOOKUP",
          "GET_LEAVE_BALANCE",
          "request_manager_approval"
        ],
        "no_branch_target": "MANAGER_APPROVAL",
        "rules": [
          {
            "description": "Employee is verified in HR master directory",
            "id": "rule_emp_matched",
            "left": "employee.matched",
            "operator": "IS_TRUE",
            "right": true
          },
          {
            "description": "All required Leave fields are present",
            "id": "rule_fields_valid",
            "left": "fields.missing_fields_count",
            "operator": "EQUALS",
            "right": 0
          },
          {
            "description": "Darwinbox available leave balance >= requested duration",
            "id": "rule_balance_sufficient",
            "left": "hrms.available_balance",
            "operator": "GREATER_OR_EQUAL",
            "right": 1,
            "right_ref": "fields.duration_days"
          },
          {
            "description": "Short leave (<= 2 days) auto-approves; > 2 days routes to Manager Approval",
            "id": "rule_short_leave_auto",
            "left": "fields.duration_days",
            "operator": "LESS_OR_EQUAL",
            "right": 2
          }
        ],
        "sla_config": {
          "escalate_100_pct_hours": 48,
          "escalate_100_pct_to": "HR Head",
          "escalate_80_pct_hours": 38,
          "escalate_80_pct_to": "Team Lead",
          "reminder_hours": 24,
          "sla_hours": 48
        },
        "subworkflows_attached": [
          "SUBFLOW-EMP-VALIDATION"
        ],
        "tenant_scope": {
          "business_unit": "All Units",
          "company": "Global Enterprise"
        },
        "test_cases": [
          {
            "expected_branch": "YES",
            "expected_case_status": "RESOLVED",
            "expected_execution_state": "COMPLETED",
            "expected_final_state": "CLOSED",
            "id": "TC-LEAVE-01",
            "mock_overrides": {
              "employee.matched": true,
              "fields.duration_days": 2,
              "fields.missing_fields_count": 0,
              "hrms.available_balance": 8
            },
            "name": "Short Casual Leave (2 Days, Balance 8) → Auto-Approve & Close"
          },
          {
            "expected_branch": "NO",
            "expected_case_status": "PENDING_APPROVAL",
            "expected_execution_state": "WAITING_FOR_APPROVAL",
            "expected_final_state": "MANAGER_APPROVAL",
            "id": "TC-LEAVE-02",
            "mock_overrides": {
              "employee.matched": true,
              "fields.duration_days": 5,
              "fields.missing_fields_count": 0,
              "hrms.available_balance": 8
            },
            "name": "Long Leave (5 Days > 2 Day Threshold) → Manager Approval Gate"
          },
          {
            "expected_branch": "NO",
            "expected_case_status": "PENDING_APPROVAL",
            "expected_execution_state": "WAITING_FOR_APPROVAL",
            "expected_final_state": "MANAGER_APPROVAL",
            "id": "TC-LEAVE-03",
            "mock_overrides": {
              "employee.matched": true,
              "fields.duration_days": 2,
              "fields.missing_fields_count": 0,
              "hrms.available_balance": 1
            },
            "name": "Insufficient Leave Balance (2 Days requested, Balance 1) → Manager Gate"
          }
        ],
        "version_history": [
          {
            "notes": "Initial baseline workflow",
            "published_at": "2026-09-01 10:00:00",
            "published_by": "System Seed",
            "sla_hours": 72,
            "states": [
              "LEAVE_REQUEST_RECEIVED",
              "POLICY_CHECK",
              "MANAGER_APPROVAL"
            ],
            "status": "ARCHIVED",
            "version": 1
          },
          {
            "notes": "Added n8n Data Enrichment, IF Rules, and Darwinbox/Truein auto-execution",
            "published_at": "2026-10-03 14:00:00",
            "published_by": "Vaibhav (HR Admin)",
            "sla_hours": 48,
            "states": [
              "LEAVE_REQUEST_RECEIVED",
              "POLICY_CHECK",
              "MANAGER_APPROVAL",
              "HRMS_UPDATED",
              "CLOSED"
            ],
            "status": "PUBLISHED",
            "version": 2
          }
        ],
        "yes_branch_actions": [
          "set_case_in_progress",
          "EMPLOYEE_LOOKUP",
          "GET_LEAVE_BALANCE",
          "update_hrms_leave",
          "CREATE_LEAVE"
        ],
        "yes_branch_target": "HRMS_UPDATED"
      },
      "state_box_types": {
        "CLOSED": "ACTION",
        "HRMS_UPDATED": "INTEGRATION",
        "LEAVE_REQUEST_RECEIVED": "TRIGGER",
        "MANAGER_APPROVAL": "HUMAN",
        "POLICY_CHECK": "CONDITION"
      }
    },
    "BGV": {
      "workflow_id": "WF-BGV-001",
      "name": "Background Verification (BGV)",
      "version": "Version 2.5",
      "category": "BGV",
      "description": "Coordinates candidate/employee document verification and BGV agency checks.",
      "initial_state": "BGV_INITIATED",
      "states": [
        "BGV_INITIATED",
        "DOCUMENT_VERIFICATION",
        "VENDOR_CHECK_IN_PROGRESS",
        "BGV_CLEARED",
        "CLOSED"
      ],
      "steps_display": [
        "BGV Initiated",
        "Document Verification",
        "Vendor Check",
        "BGV Cleared",
        "Closed"
      ],
      "transitions": [
        {
          "from_state": "BGV_INITIATED",
          "to_state": "DOCUMENT_VERIFICATION",
          "trigger": "VERIFY_BGV_DOCS",
          "conditions": [],
          "actions": [
            "set_case_in_progress",
            "EMPLOYEE_LOOKUP"
          ],
          "audit_event": "BGV document verification started"
        },
        {
          "from_state": "DOCUMENT_VERIFICATION",
          "to_state": "VENDOR_CHECK_IN_PROGRESS",
          "trigger": "DISPATCH_TO_VENDOR",
          "conditions": [],
          "actions": [
            "dispatch_bgv_vendor",
            "CREATE_BGV"
          ],
          "audit_event": "BGV package dispatched to verification vendor"
        },
        {
          "from_state": "VENDOR_CHECK_IN_PROGRESS",
          "to_state": "BGV_CLEARED",
          "trigger": "RECEIVE_BGV_REPORT",
          "conditions": [],
          "actions": [
            "record_bgv_report",
            "GET_BGV_REPORT"
          ],
          "audit_event": "BGV report received and cleared"
        },
        {
          "from_state": "BGV_CLEARED",
          "to_state": "CLOSED",
          "trigger": "RESOLVE_CASE",
          "conditions": [],
          "actions": [
            "resolve_and_close_case"
          ],
          "audit_event": "BGV case resolved and closed"
        }
      ]
    },
    "PAYROLL": {
      "workflow_id": "WF-PAYROLL-001",
      "name": "Payroll Query Resolution",
      "version": "Version 2.0",
      "category": "PAYROLL",
      "description": "Verifies salary computation, tax declarations, and reimbursement claims via Payroll Provider.",
      "initial_state": "PAYROLL_QUERY_RECEIVED",
      "states": [
        "PAYROLL_QUERY_RECEIVED",
        "PAYROLL_AUDIT",
        "ADJUSTMENT_PROCESSED",
        "CLOSED"
      ],
      "steps_display": [
        "Query Received",
        "Payroll Audit",
        "Adjustment Processed",
        "Closed"
      ],
      "transitions": [
        {
          "from_state": "PAYROLL_QUERY_RECEIVED",
          "to_state": "PAYROLL_AUDIT",
          "trigger": "START_AUDIT",
          "conditions": [],
          "actions": [
            "set_case_in_progress",
            "GET_PAYROLL_STATUS"
          ],
          "audit_event": "Payroll team started salary/tax audit"
        },
        {
          "from_state": "PAYROLL_AUDIT",
          "to_state": "ADJUSTMENT_PROCESSED",
          "trigger": "PROCESS_ADJUSTMENT",
          "conditions": [],
          "actions": [
            "update_payroll_sheet",
            "CREATE_PAYROLL_QUERY"
          ],
          "audit_event": "Payroll computation verified / adjustment recorded"
        },
        {
          "from_state": "ADJUSTMENT_PROCESSED",
          "to_state": "CLOSED",
          "trigger": "RESOLVE_CASE",
          "conditions": [],
          "actions": [
            "resolve_and_close_case"
          ],
          "audit_event": "Payroll case resolved and closed"
        }
      ]
    },
    "ASSET_IT": {
      "workflow_id": "WF-ASSET-IT-001",
      "name": "IT Asset Replacement",
      "version": "Version 2.0",
      "category": "ASSET_IT",
      "description": "Routes hardware diagnostics, IT approval, and device replacement via IT Service Desk.",
      "initial_state": "ASSET_REQUEST_RECEIVED",
      "states": [
        "ASSET_REQUEST_RECEIVED",
        "IT_DIAGNOSTICS",
        "ASSET_DISPATCHED",
        "CLOSED"
      ],
      "steps_display": [
        "Request Received",
        "IT Diagnostics",
        "Asset Dispatched",
        "Closed"
      ],
      "transitions": [
        {
          "from_state": "ASSET_REQUEST_RECEIVED",
          "to_state": "IT_DIAGNOSTICS",
          "trigger": "START_DIAGNOSTICS",
          "conditions": [],
          "actions": [
            "set_case_in_progress",
            "GET_EMPLOYEE_ASSETS"
          ],
          "audit_event": "IT Helpdesk started hardware diagnostics"
        },
        {
          "from_state": "IT_DIAGNOSTICS",
          "to_state": "ASSET_DISPATCHED",
          "trigger": "APPROVE_ASSET",
          "conditions": [],
          "actions": [
            "allocate_it_asset",
            "CREATE_IT_TICKET"
          ],
          "audit_event": "Replacement IT asset ticket created and allocated"
        },
        {
          "from_state": "ASSET_DISPATCHED",
          "to_state": "CLOSED",
          "trigger": "RESOLVE_CASE",
          "conditions": [],
          "actions": [
            "resolve_and_close_case"
          ],
          "audit_event": "IT Asset case resolved and closed"
        }
      ]
    }
  }
}